# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── LangSmith observability (optional but recommended) ───────────────────────
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=k11techlab-agentic-qa

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_MCP_URL=http://localhost:3001

# ── Test execution MCP servers ────────────────────────────────────────────────
PLAYWRIGHT_MCP_URL=http://localhost:3002
K6_MCP_URL=http://localhost:3003

# ── Issue tracking & notifications ────────────────────────────────────────────
JIRA_TOKEN=your-jira-api-token
JIRA_MCP_URL=http://localhost:3004

POSTGRES_URL=postgresql://user:pass@localhost:5432/qadb
POSTGRES_MCP_URL=http://localhost:3005

SLACK_BOT_TOKEN=xoxb-...
SLACK_MCP_URL=http://localhost:3006

# ── Knowledge Store MCP ────────────────────────────────────────────────────────
KNOWLEDGE_STORE_MCP_URL=http://localhost:3007

# ── Pipeline settings ─────────────────────────────────────────────────────────
CHECKPOINT_DB=checkpoints.db
HITL_RISK_THRESHOLD=0.85

# ── Multi-LLM Consensus Gate ──────────────────────────────────────────────────
# CONSENSUS_MODE controls how the three LLMs must agree before proceeding.
#
#   unanimous  (default) — all 3 must agree on risk bucket + std-dev < threshold
#              Best for: high-security repos, research accuracy measurement
#              Trade-off: ~20-30% of PRs may trigger forced HITL on disagreement
#
#   majority   (recommended for production) — 2 of 3 must agree on bucket
#              Best for: standard CI/CD pipelines, mixed-risk codebases
#              Trade-off: ~60% fewer forced HITL triggers vs unanimous
#
#   weighted   (highest throughput) — no bucket check, variance check only
#              Best for: low-risk repos, fast delivery pipelines
#              Trade-off: least epistemic safety signal
#
CONSENSUS_MODE=unanimous

# Maximum allowed std-dev across model scores before forcing HITL (default: 0.20)
CONSENSUS_VARIANCE_THRESHOLD=0.20
